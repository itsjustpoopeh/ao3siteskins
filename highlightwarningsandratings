  /*
    -----------------INFO-----------------
  CSS to highlight the archive required warnings
  Don't use this and Highlight Warnings Flexible together there's no point. pick one
  Major triggers are highlighted red
  Minor warnings highlighted orange
  NAWA highlighted green
  Ratings are highlighted according to archive colors
  */

/*ARCHIVE WARNINGS RED*/

.tag[href$="/tags/Choose%20Not%20To%20Use%20Archive%20Warnings/works"],
.tag[href$="/tags/Rape*s*Non-Con/works" i],
.tag[href$="/tags/Major%20Character%20Death/works"] {
  font-weight: bold !important;
  color: DarkOrange !important;
  background-color: DarkRed !important;
}

/*ARCHIVE WARNINGS ORANGE*/

.tag[href$="/tags/Graphic%20Depictions%20Of%20Violence/works"],
.tag[href$="/tags/Underage%20Sex/works"] {
  font-weight: bold !important;
  color: DarkRed !important;
  background-color: DarkOrange !important;
}

/*ARCHIVE WARNINGS GREEN*/

.tag[href$="/tags/No%20Archive%20Warnings%20Apply/works"] {
  font-weight: bold !important;
  color: white !important;
  background-color: DarkGreen !important;
}

/*RATINGS*/

/*RED*/

.tag[href$="/tags/Explicit/works" i] {
  font-weight: bold !important;
  color: DarkOrange !important;
  background-color: DarkRed !important;
}

/*ORANGE*/

.tag[href$="/tags/Mature/works" i] {
  font-weight: bold !important;
  color: white !important;
  background-color: DarkOrange !important;
}

/*YELLOW*/

.tag[href$="/tags/Teen%20And%20Up%20Audiences/works"] {
  font-weight: bold !important;
  color: white !important;
  background-color: Gold !important;
}

/*GREEN*/

.tag[href$="/tags/General%20Audiences/works"] {
  font-weight: bold !important;
  color: white !important;
  background-color: DarkGreen !important;
}

/*GRAY*/

.tag[href$="/tags/Not%20Rated/works"] {
  font-weight: bold !important;
  color: white !important;
  background-color: DarkGray !important;
}
